# Mandato AR — never commit real secrets

# Mandate signing (demo only - use your own secret in production)
MANDATE_SIGNING_MODE=hmac
MANDATE_HMAC_SECRET=change-me-demo-only
# MANDATE_ED25519_PRIVATE_PEM=

# x402 API configuration
X402_RESOURCE_BASE=https://ar-agent-fx.mswitach.workers.dev
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532

# Buyer configuration for live payments
# BUYER_PRIVATE_KEY=0x... (EVM private key with Base Sepolia ETH for gas + USDC testnet)
BUYER_DRY_RUN=true

# To enable live payments:
# 1. Get Base Sepolia testnet ETH from: https://www.coinbase.com/faucets/base-ethereum-goerli-faucet
# 2. Get Base Sepolia USDC testnet tokens:
#    - Bridge from Sepolia using https://testnets.superbridge.app/base-sepolia
#    - Or request from Circle's testnet faucet (if available)
# 3. Set BUYER_PRIVATE_KEY to your throwaway wallet private key (never use production keys!)
# 4. Set BUYER_DRY_RUN=false
# 5. Run: pnpm ask -- --live "dolar blue"
#
# USDC on Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Payment uses EIP-3009 (gasless USDC transfer) via x402 Exact EVM scheme
