{
  "name": "mandato-ar",
  "private": true,
  "version": "0.1.0",
  "description": "MVP Intent Mandate agent for AR data via x402",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @mandato-ar/mandate test && pnpm --filter @mandato-ar/buyer test",
    "ask": "pnpm --filter @mandato-ar/cli start -- ask",
    "dev:web": "pnpm --filter @mandato-ar/web dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^3.25.76"
  }
}
